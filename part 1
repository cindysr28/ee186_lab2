#include <stdint.h>

#define RCC_ADDR 0x40021000
#define RCC_APB2ENR_OFFSET 0x60

#define SYSCFG_ADDR 0x40010000
#define SYSCFG_EXTICR4_OFFSET 0x14

#define EXTI_ADDR 0x40010400
#define EXTI_IMR1_OFFSET 0x00
#define EXTI_RTSR1_OFFSET 0x08
#define EXTI_FTSR1_OFFSET 0x0C
#define EXTI_PR1_OFFSET 0x14

#define NVIC_ISER1_ADDR 0xE000E104
#define GPIOB_ODR_ADDR 0x48000414


void EXTI15_10_IRQHandler(void)
{
    volatile uint32_t *exti_pr1 = (volatile uint32_t *)(EXTI_ADDR + EXTI_PR1_OFFSET);

    // only handle the button's EXTI13 interrupt
    if ((*exti_pr1 & (1 << 13)) != 0) {
        // EXTI pending flags are cleared by writing 1
        *exti_pr1 = (1 << 13);
        *(volatile uint32_t *)GPIOB_ODR_ADDR ^= (1 << 7); // toggle blue LED
    }
}


int main(void)
{
    // Enable GPIOB and GPIOC clocks
    volatile uint32_t *rcc_ahb2enr = (volatile uint32_t *)0x4002104C;
    uint32_t cur_value = *rcc_ahb2enr;
    cur_value = cur_value | 0x00000002;
    cur_value = cur_value | 0x00000004;
    *rcc_ahb2enr = cur_value;
    (void)*rcc_ahb2enr; // read back before accessing GPIO

    volatile uint32_t *gpiob_moder = (volatile uint32_t *)0x48000400;
    volatile uint32_t *gpioc_moder = (volatile uint32_t *)0x48000800;
    uint32_t mode;

    // PB7: blue LED output mode 01
    mode = *gpiob_moder;
    mode = mode & ~0x0000C000;
    mode = mode | 0x00004000;
    *gpiob_moder = mode;

    // start with blue off
    *(volatile uint32_t *)GPIOB_ODR_ADDR &= ~(1 << 7);

    // PC13: button input mode 00, controlled by bits 26 and 27
    mode = *gpioc_moder;
    mode = mode & ~(3 << 26);
    *gpioc_moder = mode;

    // PC13 pull-down: released = low, pressed = high.
    volatile uint32_t *gpioc_pupdr = (volatile uint32_t *)0x4800080C;
    *gpioc_pupdr &= ~(3 << 26); // b11-> 2 ones are put in 27:26
    *gpioc_pupdr |= (2 << 26); // b10

    // enable SYSCFG clock
    volatile uint32_t *rcc_apb2enr = (volatile uint32_t *)(RCC_ADDR + RCC_APB2ENR_OFFSET);
    *rcc_apb2enr |= (1 << 0);
    (void)*rcc_apb2enr;

    // Connect PC13 to EXTI13
    // EXTICR4 bits 7:4 select EXTI13's port-- 0010 = GPIOC
    volatile uint32_t *syscfg_exticr4 = (volatile uint32_t *)(SYSCFG_ADDR + SYSCFG_EXTICR4_OFFSET);
    *syscfg_exticr4 &= ~(15 << 4);
    *syscfg_exticr4 |= (2 << 4);

    volatile uint32_t *exti_rtsr1 = (volatile uint32_t *)(EXTI_ADDR + EXTI_RTSR1_OFFSET);
    volatile uint32_t *exti_ftsr1 = (volatile uint32_t *)(EXTI_ADDR + EXTI_FTSR1_OFFSET);
    volatile uint32_t *exti_pr1 = (volatile uint32_t *)(EXTI_ADDR + EXTI_PR1_OFFSET);
    volatile uint32_t *exti_imr1 = (volatile uint32_t *)(EXTI_ADDR + EXTI_IMR1_OFFSET);

    *exti_ftsr1 &= ~(1 << 13); // disable interrupt on release
    *exti_rtsr1 |= (1 << 13); // enable interrupt on press
    *exti_pr1 = (1 << 13); // clear any old pending flag
    *exti_imr1 |= (1 << 13); // unmask EXTI13 interrupt

    // EXTI15_10 is IRQ 40: ISER1 bit (40 - 32) = 8
    volatile uint32_t *nvic_iser1 = (volatile uint32_t *)NVIC_ISER1_ADDR;
    *nvic_iser1 = (1 << 8);

    while (1) {}
}
